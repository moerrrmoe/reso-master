# Required environment variables
# Copy this file to .env and fill in your values — never commit .env itself

# Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=
API_HASH=

# Bot access control — users must send /start <SECRET_KEY> to be authorized
SECRET_KEY=

# Path to store Telegram session files (relative to project root)
SESSION_PATH=bot_session

# SQLite database path used by Prisma
DATABASE_URL="file:./prisma/dev.db"

# Directories for downloaded and encoded media (relative to project root)
DOWNLOAD_VIDEOS_PATH=downloads
ENCODED_VIDEOS_PATH=encode_output
